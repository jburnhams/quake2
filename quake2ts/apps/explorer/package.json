{
  "name": "@quake2ts/explorer",
  "version": "0.0.878",
  "private": true,
  "description": "Browse Quake 2 PAK files: the file tree, pictures, textures, models, sounds and maps. Built on strata-react and the quake2ts libraries.",
  "type": "module",
  "license": "GPL-2.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:unit": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@quake2ts/engine": "workspace:*",
    "@quake2ts/formats": "workspace:*",
    "@quake2ts/server": "workspace:*",
    "@tanstack/react-query": "^5.107.1",
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "strata-react": "^1.3.16",
    "strata-vfs": "workspace:*"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.2.1",
    "jsdom": "^31.0.1",
    "msw": "^3.0.4",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.6",
    "vitest": "^5.1.1"
  }
}
