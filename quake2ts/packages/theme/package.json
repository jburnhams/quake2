{
  "name": "@quake2ts/theme",
  "version": "0.0.878",
  "private": true,
  "description": "A Quake look for strata-react apps: olive gunmetal and HUD amber, phosphor-green focus, a condensed display face and a console face, metal-plate pane headers. CSS only, drawn procedurally; no id Software art.",
  "type": "module",
  "license": "GPL-2.0",
  "exports": {
    "./quake.css": "./src/quake.css",
    "./palette.generated.css": "./src/palette.generated.css"
  },
  "sideEffects": ["*.css"],
  "repository": {
    "type": "git",
    "url": "https://github.com/jburnhams/quake2.git",
    "directory": "quake2ts/packages/theme"
  },
  "scripts": {
    "palette": "node scripts/palette.mjs",
    "test": "vitest run",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/teko": "^5.3.0",
    "@fontsource/vt323": "^5.3.0"
  },
  "peerDependencies": {
    "strata-react": "^1.3.16"
  },
  "devDependencies": {
    "vitest": "^5.1.1"
  }
}
