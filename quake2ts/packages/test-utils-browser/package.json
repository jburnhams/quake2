{
  "name": "@quake2ts/test-utils-browser",
  "version": "0.0.878",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "test": "vitest run"
  },
  "dependencies": {
    "@quake2ts/test-utils": "workspace:*",
    "pixelmatch": "^8.0.0",
    "playwright": "^1.65.1",
    "pngjs": "^7.0.0",
    "vitest": "^5.1.1"
  },
  "devDependencies": {
    "@types/pngjs": "^6.0.5",
    "tsup": "^9.0.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
